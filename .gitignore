# ---------------------------------------------------------------------------
# Biological data (raw / interim / processed) — never committed.
# Provenance lives in data/manifests/, which IS tracked (see below).
# ---------------------------------------------------------------------------
data/raw/mmcif/
data/raw/api/
data/raw/external/
data/interim/

# data/processed/ is ignored by default (working/derived files), EXCEPT the
# final team-handoff deliverables explicitly tracked below (each small
# enough for normal Git — see reports/tables/final_data_dictionary.md and
# TEAM_HANDOFF.md for what they contain and how to regenerate them).
data/processed/*
!data/processed/structures.csv
!data/processed/excluded_structures.csv
!data/processed/final_lbd_residue_map_primary_qc_subset.parquet
!data/processed/structures_primary_qc_subset.csv
!data/processed/lbd_residue_bfactors_all.parquet

# Logs
logs/

